package main

import (
 "fmt"
 "math"
)

func printMatrix(matrix [][]float64) {
 for _, row := range matrix {
  for _, value := range row {
   fmt.Printf("%10.4f ", value)
  }
  fmt.Println()
 }
}

func gaussianElimination(matrix [][]float64) []float64 {
 n := len(matrix)

 // Прямой ход
 for i := 0; i < n; i++ {
  maxElement := math.Abs(matrix[i][i])
  maxRow := i
  for k := i + 1; k < n; k++ {
   if math.Abs(matrix[k][i]) > maxElement {
    maxElement = math.Abs(matrix[k][i])
    maxRow = k
   }
  }

  // Перестановка строк
  matrix[i], matrix[maxRow] = matrix[maxRow], matrix[i]

  for k := i + 1; k < n; k++ {
   factor := matrix[k][i] / matrix[i][i]
   for j := i; j <= n; j++ {
    matrix[k][j] -= factor * matrix[i][j]
   }
  }
 }

 // Обратный ход
 result := make([]float64, n)
 for i := n - 1; i >= 0; i-- {
  result[i] = matrix[i][n] / matrix[i][i]
  for k := i - 1; k >= 0; k-- {
   matrix[k][n] -= matrix[k][i] * result[i]
  }
 }

 return result
}

func main() {
 var n int
 fmt.Print("Введите размерность матрицы: ")
 fmt.Scan(&n)

 matrix := make([][]float64, n)
 for i := 0; i < n; i++ {
  matrix[i] = make([]float64, n+1)
 }

 fmt.Println("Введите элементы расширенной матрицы (коэффициенты и свободные члены):")
 for i := 0; i < n; i++ {
  for j := 0; j <= n; j++ {
   fmt.Scan(&matrix[i][j])
  }
 }

 fmt.Println("Исходная матрица:")
 printMatrix(matrix)

 result := gaussianElimination(matrix)

 fmt.Println("Решение системы:")
 for i, value := range result {
  fmt.Printf("x%d = %.6f\n", i+1, value)
 }
}
